# ==============================================================================
# Vaultzet Store - Environment Configuration
# ==============================================================================

# Canonical Site URL (Used for sitemaps, canonicals, Open Graph, and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.vaultzet.shop

# Google Tag Manager (GTM Container ID - Primary tag orchestrator)
NEXT_PUBLIC_GTM_ID=GTM-TD8N9SDD

# Google Analytics 4 (Measurement ID - Direct or GTM fallback)
NEXT_PUBLIC_GA4_ID=G-7RMXL2RZ4J

# Google Search Console Verification (HTML meta tag content value)
NEXT_PUBLIC_GSC_VERIFICATION=googlef90de30240e3b03b

# Bing Webmaster Tools Verification (msvalidate.01 content value)
NEXT_PUBLIC_BING_VERIFICATION=

# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=1715650960276913

# IndexNow Key for Bing & Yandex instant indexing
NEXT_PUBLIC_INDEXNOW_KEY=c3e2f1a94b8d7e0c9f1a2b3c4d5e6f7a

# Telegram Instant Alerts & Command Center (@Vault_World_bot)
TELEGRAM_BOT_TOKEN=8661050113:AAHwHpUC5rgY4yxTjaEmp16DeAoJkCr8zlA
TELEGRAM_CHAT_ID=7483268297
TELEGRAM_OWNER_CHAT_ID=7483268297
TELEGRAM_ALLOWED_USER_IDS=7483268297,5950203511,6206169480

# ImgBB API Key (For secure admin image & thumbnail uploads from device gallery)
# Get your free API key at: https://api.imgbb.com/
IMGBB_API_KEY=your_imgbb_api_key_here

# ==============================================================================
# Admin Portal Security Password (/asdf)
# ==============================================================================
ADMIN_PASSWORD=your_secret_admin_password
NEXT_PUBLIC_ADMIN_PASSWORD=your_secret_admin_password

# ==============================================================================
# PayU Payment Gateway (India UPI, Cards, NetBanking)
# Dashboard: https://merchant.payu.in/ > Integration / API Credentials
# ==============================================================================
PAYU_KEY=your_payu_merchant_key
PAYU_SALT=your_payu_merchant_salt
PAYU_ENV=PRODUCTION
NEXT_PUBLIC_ACTIVE_PAYMENT_GATEWAY=payu
